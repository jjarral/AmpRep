# .dockerignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Local environment (keep .env.example for reference)
.env.local
.env.development
.env
.env.*
!.env.example

# Local databases, backups, and generated data must not enter deployment images
*.db
backups/
static/uploads/
static/reports/
static/barcodes/
static/qrcodes/
static/logos/

# Repository metadata
.git/
