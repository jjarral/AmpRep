# .env.example

# The secret key for the Flask application, used for session management and data protection
SECRET_KEY='your_secret_key_here'

# The database URL for the application, should include username, password, host, and database name
DATABASE_URL='postgres://user:password@localhost:5432/mydatabase?sslmode=require'

# The port for the Flask application to run on (Cloud Run default is 8080)
PORT=8080

# The environment for Flask, should be 'development' or 'production'
FLASK_ENV='production'

# Other optional configurations
DEBUG=False
ALLOWED_HOSTS='*'

# Public inquiry email confirmation. Enable only after verifying the sender domain.
RESEND_API_KEY=''
EMAIL_FROM='Ampoulex <confirmation@notify.ampoulex.com>'
INQUIRY_EMAIL_VERIFICATION_REQUIRED=false

# Required only when the configured database has no admin user yet.
INITIAL_ADMIN_USERNAME='admin'
INITIAL_ADMIN_EMAIL='admin@example.com'
INITIAL_ADMIN_PASSWORD='replace_with_a_unique_long_password'

# Cloud Run specific settings
# Cloud Run automatically sets PORT environment variable
# No need to set GUNICORN_CMD_ARGS - handled in Dockerfile
